# Description: 
## Gatemate A1-EVB Olimex board hardware pin constraints
## #######################################################


# Format:
# <pin-direction> "<pin-name>" Loc = "<pin-location>" | <opt.-constraints>;
#
# Additional constraints can be appended using the pipe symbol.
# Files are read line by line. Text after the hash symbol is ignored.
#
# Available pin directions:
#
# Pin_in
#   defines an input pin
# Pin_out
#   defines an output pin
# Pin_inout
#   defines a bidirectional pin
#
# Available pin constraints:
#
# SCHMITT_TRIGGER={true,false}
#   enables or disables schmitt trigger (hysteresis) option
# PULLUP={true,false}
#   enables or disables I/O pullup resistor of nominal 50kOhm
# PULLDOWN={true,false}
#   enables or disables I/O pulldown resistor of nominal 50kOhm
# KEEPER={true,false}
#   enables or disables I/O keeper option
# SLEW={slow,fast}
#   sets slew rate to slow or fast
# DRIVE={3,6,9,12}
#   sets output drive strength to 3mA..12mA
# DELAY_OBF={0..15}
#   adds an additional delay of n * nominal 50ps to output signal
# DELAY_IBF={0..15}
#   adds an additional delay of n * nominal 50ps to input signal
# FF_IBF={true,false}
#   enables or disables placing of FF in input buffer, if possible
# FF_OBF={true,false}
#   enables or disables placing of FF in output buffer, if possible
# LVDS_BOOST={true,false}
#   enables increased LVDS output current of 6.4mA (default: 3.2mA)
# LVDS_TERM={true,false}
#   enables on-chip LVDS termination resistor of nominal 100Ohm, in output mode only
#
# Global IO constraints can be set with the default_GPIO statement. It can be
# overwritten by individual settings for specific GPIOs, e.g.:
#   default_GPIO | DRIVE=3; # sets all output strengths to 3mA, unless overwritten
#========================================================================


## Generally used IO Pins
# #######################################################
# LED, 4 Clocks for PLL
# #######################################################
# -------------------------------------------------------
Pin_in "CLK0" Loc = "IO_SB_A8"  | SCHMITT_TRIGGER=true;
Pin_in "FPGA_BUT" Loc = "IO_SB_B7" | PULLUP=true;


######## PSRAM #############
Pin_out    "PSRAM_CSN"       Loc = "IO_WC_A4";
Pin_out    "PSRAM_SCLK"      Loc = "IO_WC_B4";
Pin_inout  "PSRAM_DATA[0]"   Loc = "IO_WC_A5";
Pin_inout  "PSRAM_DATA[1]"   Loc = "IO_WC_B5";
Pin_inout  "PSRAM_DATA[2]"   Loc = "IO_WC_A6";
Pin_inout  "PSRAM_DATA[3]"   Loc = "IO_WC_B6";
Pin_inout  "PSRAM_DATA[4]"   Loc = "IO_WC_A7";
Pin_inout  "PSRAM_DATA[5]"   Loc = "IO_WC_B7";
Pin_inout  "PSRAM_DATA[6]"   Loc = "IO_WC_A8";
Pin_inout  "PSRAM_DATA[7]"   Loc = "IO_WC_B8";



######## VGA #############

Pin_out "VGA_HSync" Loc = "IO_WB_A1";
Pin_out "VGA_VSync" Loc = "IO_WB_B1";
Pin_out "VGA_Red[3]" Loc = "IO_WB_A2";
Pin_out "VGA_Red[2]" Loc = "IO_WB_B2";
Pin_out "VGA_Red[1]" Loc = "IO_WB_A3";
Pin_out "VGA_Red[0]" Loc = "IO_WB_B3";
Pin_out "VGA_Green[3]" Loc = "IO_WB_A4";
Pin_out "VGA_Green[2]" Loc = "IO_WB_B4";
Pin_out "VGA_Green[1]" Loc = "IO_WB_A5";
Pin_out "VGA_Green[0]" Loc = "IO_WB_B5";
Pin_out "VGA_Blue[3]" Loc = "IO_WB_A6";
Pin_out "VGA_Blue[2]" Loc = "IO_WB_B6";
Pin_out "VGA_Blue[1]" Loc = "IO_WB_A7";
Pin_out "VGA_Blue[0]" Loc = "IO_WB_B7";

############ Mcu ################

Pin_in "GPIO12_DBG_UART_TX" Loc = "IO_SA_A6";
Pin_out "GPIO13_DBG_UART_RX" Loc = "IO_SA_B6";

#Pin_in "JTAG_TCK" Loc = "IO_WA_A5";
#Pin_in "JTAG_TMS" Loc = "IO_WA_B4";
#Pin_in "JTAG_TDI" Loc = "IO_WA_A4";
#Pin_out "JTAG_TDO" Loc = "IO_WA_B3";

############ debugBus ################

Pin_out "NA_A[0]" Loc = "IO_NA_A0" | SLEW=fast;
Pin_out "NA_A[1]" Loc = "IO_NA_A1" | SLEW=fast;
Pin_out "NA_A[2]" Loc = "IO_NA_A2" | SLEW=fast;
Pin_out "NA_A[3]" Loc = "IO_NA_A3" | SLEW=fast;
Pin_out "NA_A[4]" Loc = "IO_NA_A4" | SLEW=fast;
Pin_out "NA_A[5]" Loc = "IO_NA_A5" | SLEW=fast;
Pin_out "NA_A[6]" Loc = "IO_NA_A6" | SLEW=fast;
Pin_out "NA_A[7]" Loc = "IO_NA_A7" | SLEW=fast;
Pin_out "NA_A[8]" Loc = "IO_NA_A8" | SLEW=fast;

Pin_out "NA_B[0]" Loc = "IO_NA_B0" | SLEW=fast;
Pin_out "NA_B[1]" Loc = "IO_NA_B1" | SLEW=fast;
Pin_out "NA_B[2]" Loc = "IO_NA_B2" | SLEW=fast;
Pin_out "NA_B[3]" Loc = "IO_NA_B3" | SLEW=fast;
Pin_out "NA_B[4]" Loc = "IO_NA_B4" | SLEW=fast;
Pin_out "NA_B[5]" Loc = "IO_NA_B5" | SLEW=fast;
Pin_out "NA_B[6]" Loc = "IO_NA_B6" | SLEW=fast;
Pin_out "NA_B[7]" Loc = "IO_NA_B7" | SLEW=fast;
Pin_out "NA_B[8]" Loc = "IO_NA_B8" | SLEW=fast;


# BANK_EB1 for external jtag

Pin_inout "EB_A[0]" Loc = "IO_EB_A0" | SLEW=fast;
Pin_inout "EB_A[1]" Loc = "IO_EB_A1" | PULLUP=true; // pullup on jtag pins if not connected
Pin_inout "EB_A[2]" Loc = "IO_EB_A2" | PULLUP=true;
Pin_inout "EB_A[3]" Loc = "IO_EB_A3" | PULLUP=true;
Pin_inout "EB_A[4]" Loc = "IO_EB_A4" | SLEW=fast;
Pin_inout "EB_A[5]" Loc = "IO_EB_A5" | SLEW=fast;
Pin_inout "EB_A[6]" Loc = "IO_EB_A6" | SLEW=fast;
Pin_inout "EB_A[7]" Loc = "IO_EB_A7" | SLEW=fast;
Pin_inout "EB_A[8]" Loc = "IO_EB_A8" | SLEW=fast;

